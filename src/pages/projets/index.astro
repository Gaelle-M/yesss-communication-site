---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Defilement from "../../components/ui/Defilement.astro";
import ListeProjets from "../../components/sections/ListeProjets.astro";
import { getImage } from "../../lib/images";
import page from "../../content/pages/projets.json";

const projets = (await getCollection("projets")).sort((a, b) => a.data.ordre - b.data.ordre);
const logos = page.clients.logos.map((l) => ({ src: getImage(l.image), alt: l.alt }));
---

<BaseLayout title={page.meta.titre} description={page.meta.description} header="plein">
  <div class="projets">
    <h1 class="projets__titre">{page.titre}</h1>
    <div class="projets__clients">
      <Defilement images={logos} label={page.clients.label} parVue={[3, 5, 7]} ratio="266 / 144" ajustement="contain" vitesse={2.5} widths={[266]} />
    </div>
    <ListeProjets projets={projets} textes={page} />
  </div>
</BaseLayout>

<style>
  .projets {
    padding-top: var(--space-xl);
  }

  .projets__titre {
    font-size: var(--text-2xl);
    text-align: center;
  }

  .projets__clients {
    width: min(100% - 2 * var(--gutter), var(--container-max));
    margin: var(--space-lg) auto var(--space-xl);
  }
</style>
