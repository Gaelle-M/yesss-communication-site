---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TitrePage from "../../components/ui/TitrePage.astro";
import page from "../../content/pages/expertises.json";

const expertises = (await getCollection("expertises")).sort((a, b) => a.data.ordre - b.data.ordre);
// L'image d'introduction est souvent le même visuel que la vignette, en plus grande résolution :
// on la prend si ses proportions sont les mêmes, sinon on garde la vignette.
const ratio = (i: { width: number; height: number }) => i.width / i.height;
const visuel = (e: (typeof expertises)[number]) => {
  const vignette = e.data.vignette.src;
  const intro = e.data.sections.find((s) => s.type === "intro");
  const image = intro && "image" in intro ? intro.image.src : undefined;
  return image && Math.abs(ratio(image) - ratio(vignette)) < 0.1 ? image : vignette;
};
---

<BaseLayout title={page.meta.titre} description={page.meta.description} header="plein">
  <TitrePage texte={page.titre} />
  <ul class="expertises container" role="list">
    {
      expertises.map((e) => (
        <li>
          <a class="expertises__lien" href={`/nos-expertises/${e.id}/`}>
            <Image src={visuel(e)} alt="" widths={[360, 720]} sizes="(min-width: 64rem) 23rem, (min-width: 40rem) 45vw, 85vw" />
            <span>{page.lien.replace("{nom}", e.data.nom)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .expertises {
    display: grid;
    gap: var(--space-lg) var(--space-md);
    max-width: var(--container-max);
    padding: var(--space-md) 0 var(--space-2xl);
    list-style: none;
  }

  .expertises__lien {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    color: var(--color-bleu-fonce);
    font-size: var(--text-sm);
    text-align: center;
    text-underline-offset: 0.2em;
  }

  .expertises__lien img {
    width: min(100%, 23rem);
    transition: transform 0.4s ease;
  }

  .expertises__lien:hover img {
    transform: scale(1.04);
  }

  .expertises__lien:hover span {
    color: var(--color-bleu-nuit);
  }

  @media (min-width: 40rem) {
    .expertises {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .expertises {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
