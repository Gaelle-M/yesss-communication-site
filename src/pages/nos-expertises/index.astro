---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TitrePage from "../../components/ui/TitrePage.astro";
import page from "../../content/pages/expertises.json";

const expertises = (await getCollection("expertises")).sort((a, b) => a.data.ordre - b.data.ordre);
---

<BaseLayout title={page.meta.titre} description={page.meta.description} header="plein">
  <TitrePage texte={page.titre} />
  <ul class="expertises container" role="list">
    {
      expertises.map((e) => (
        <li>
          <a class="expertises__lien" href={`/nos-expertises/${e.id}/`}>
            <Image src={e.data.vignette.src} alt="" widths={[300, 600]} sizes="(min-width: 48rem) 18rem, 70vw" />
            <span>{page.lien.replace("{nom}", e.data.nom)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .expertises {
    display: grid;
    gap: var(--space-lg) var(--space-md);
    max-width: var(--container-narrow);
    padding: var(--space-md) 0 var(--space-2xl);
    list-style: none;
  }

  .expertises__lien {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    color: var(--color-bleu-fonce);
    font-size: var(--text-sm);
    text-align: center;
    text-underline-offset: 0.2em;
  }

  .expertises__lien img {
    width: min(100%, 18rem);
    transition: transform 0.4s ease;
  }

  .expertises__lien:hover img {
    transform: scale(1.04);
  }

  .expertises__lien:hover span {
    color: var(--color-bleu-nuit);
  }

  @media (min-width: 40rem) {
    .expertises {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .expertises {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
