---
/**
 * Vague de transition, posée en haut d'une section.
 * `color` = couleur de la section précédente (variable CSS).
 */
interface Props {
  color: string;
  flip?: boolean;
}

const { color, flip = false } = Astro.props;
---

<div class:list={["wave", { "wave--flip": flip }]} style={`--wave-color: ${color}`} aria-hidden="true">
  <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
    <path
      d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
    ></path>
  </svg>
</div>

<style>
  .wave {
    position: absolute;
    inset: -1px 0 auto;
    height: var(--wave-height);
    pointer-events: none;
  }

  .wave svg {
    width: 100%;
    height: 100%;
  }

  .wave path {
    fill: var(--wave-color);
  }

  .wave--flip svg {
    transform: scaleX(-1);
  }
</style>
