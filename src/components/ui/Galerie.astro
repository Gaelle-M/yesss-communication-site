---
/**
 * Carrousel d'images : défilement au doigt / au trackpad (sans JS),
 * flèches précédent / suivant ajoutées par le script.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  labels: { label: string; precedent: string; suivant: string; position: string };
}

const { images, labels } = Astro.props;
const position = (n: number) => labels.position.replace("{n}", String(n)).replace("{total}", String(images.length));
---

<section class="galerie" aria-roledescription="carrousel" aria-label={labels.label}>
  <ul class="galerie__piste" role="list">
    {
      images.map((img, i) => (
        <li class="galerie__item" role="group" aria-roledescription="diapositive" aria-label={position(i + 1)}>
          <Image
            src={img.src}
            alt={img.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 60rem) 50vw, 100vw"
            loading={i === 0 ? "eager" : "lazy"}
          />
        </li>
      ))
    }
  </ul>
  {
    images.length > 1 && (
      <div class="galerie__fleches" hidden>
        <button type="button" class="galerie__fleche galerie__fleche--prec" data-sens="-1">
          <span class="visually-hidden">{labels.precedent}</span>
        </button>
        <button type="button" class="galerie__fleche galerie__fleche--suiv" data-sens="1">
          <span class="visually-hidden">{labels.suivant}</span>
        </button>
      </div>
    )
  }
</section>

<script>
  document.querySelectorAll<HTMLElement>(".galerie").forEach((galerie) => {
    const piste = galerie.querySelector<HTMLElement>(".galerie__piste");
    const fleches = galerie.querySelector<HTMLElement>(".galerie__fleches");
    if (!piste || !fleches) return;
    fleches.hidden = false;

    fleches.querySelectorAll<HTMLButtonElement>("button").forEach((bouton) => {
      bouton.addEventListener("click", () => {
        const largeur = piste.clientWidth;
        const index = Math.round(piste.scrollLeft / largeur) + Number(bouton.dataset.sens);
        const total = piste.children.length;
        // On boucle : après la dernière image, retour à la première
        piste.scrollTo({ left: ((index + total) % total) * largeur, behavior: "smooth" });
      });
    });
  });
</script>

<style>
  .galerie {
    position: relative;
    height: 100%;
  }

  .galerie__piste {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }

  .galerie__piste::-webkit-scrollbar {
    display: none;
  }

  .galerie__item {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .galerie__item img {
    width: 100%;
    height: 100%;
    aspect-ratio: 960 / 913;
    object-fit: cover;
  }

  .galerie__fleche {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: var(--color-blanc);
    color: var(--color-bleu-nuit);
    cursor: pointer;
    transform: translateY(-50%);
  }

  .galerie__fleche--prec {
    left: 0;
  }

  .galerie__fleche--suiv {
    right: 0;
  }

  /* Flèche dessinée en CSS : trait + pointe */
  .galerie__fleche::before {
    content: "";
    width: 1.1rem;
    height: 2px;
    background: currentColor;
  }

  .galerie__fleche::after {
    content: "";
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
  }

  .galerie__fleche--suiv::after {
    right: 0.7rem;
    transform: rotate(45deg);
  }

  .galerie__fleche--prec::after {
    left: 0.7rem;
    transform: rotate(-135deg);
  }
</style>
