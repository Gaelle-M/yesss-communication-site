---
/** Carrousel de photos pleine largeur avec titre (« Partenaires and Co ») */
import type { ImageMetadata } from "astro";
import TitreLigne from "../ui/TitreLigne.astro";
import Galerie from "../ui/Galerie.astro";
import { texteBrut } from "../../lib/inline";
import site from "../../content/site.json";

interface Props {
  titre: string;
  images: { src: ImageMetadata; alt: string }[];
}

const { titre, images } = Astro.props;
const nom = texteBrut(titre);
---

<section class="photos">
  <TitreLigne texte={titre} />
  <Galerie
    images={images}
    labels={{ label: nom, ...site.accessibilite.galeriePhotos }}
    ratio="16 / 9"
    sizes="100vw"
    widths={[640, 1280, 1920]}
  />
</section>

<style>
  .photos {
    display: grid;
    gap: var(--space-md);
  }
</style>
