---
/** Bande de photos pleine largeur qui défile en continu, avec titre (« Partenaires and Co ») */
import type { ImageMetadata } from "astro";
import TitreLigne from "../ui/TitreLigne.astro";
import Defilement from "../ui/Defilement.astro";
import { texteBrut } from "../../lib/inline";

interface Props {
  titre: string;
  images: { src: ImageMetadata; alt: string }[];
}

const { titre, images } = Astro.props;
const nom = texteBrut(titre);
---

<section class="photos">
  <TitreLigne texte={titre} />
  <Defilement images={images} label={nom} parVue={[2, 4, 5]} ratio="380 / 340" />
</section>

<style>
  .photos {
    display: grid;
    gap: var(--space-md);
  }
</style>
