---
/** Bandeau d'appel à l'action ("Envie de faire rayonner votre marque ?") aux couleurs du thème */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import RichText, { type Segment } from "../ui/RichText.astro";
import Button from "../ui/Button.astro";

interface Props {
  titre: Segment[];
  bouton: { label: string; href: string };
  image?: ImageMetadata;
}

const { titre, bouton, image } = Astro.props;
---

<section class="bandeau">
  {image && <Image class="bandeau__fond" src={image} alt="" widths={[800, 1600]} sizes="100vw" />}
  <div class="bandeau__inner container">
    <h2 class="bandeau__titre"><RichText segments={titre} /></h2>
    <Button {...bouton} variant="theme" />
  </div>
</section>

<style>
  .bandeau {
    position: relative;
    display: grid;
    min-height: 12.5rem;
    overflow: hidden;
    background: var(--bandeau-fond);
    color: var(--bandeau-texte);
  }

  .bandeau__fond {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bandeau__inner {
    position: relative;
    display: grid;
    align-items: center;
    justify-items: center;
    gap: var(--space-md);
    padding-block: var(--space-lg);
    text-align: center;
  }

  .bandeau__titre {
    font-size: clamp(1.75rem, 1rem + 2.2vw, 2.8rem);
  }

  .bandeau__titre :global(.txt-script) {
    font-size: 1.5em;
  }

  .bandeau :global(.btn) {
    min-width: 0;
  }

  @media (min-width: 60rem) {
    .bandeau__inner {
      grid-template-columns: 1fr auto;
      justify-items: start;
      gap: var(--space-lg);
      text-align: left;
    }
  }
</style>
