---
/** Affiche une suite de sections typées, telle que décrite dans un fichier de contenu. */
import SectionIntro from "./SectionIntro.astro";
import SectionMissions from "./SectionMissions.astro";
import SectionPictos from "./SectionPictos.astro";
import SectionColonnes from "./SectionColonnes.astro";
import SectionPourquoi from "./SectionPourquoi.astro";
import SectionCta from "./SectionCta.astro";
import SectionRealisations from "./SectionRealisations.astro";
import SectionChapo from "./SectionChapo.astro";
import SectionTexte from "./SectionTexte.astro";
import SectionManifeste from "./SectionManifeste.astro";
import SectionAppel from "./SectionAppel.astro";
import SectionValeurs from "./SectionValeurs.astro";
import SectionEngagements from "./SectionEngagements.astro";
import SectionEquipe from "./SectionEquipe.astro";
import SectionPhotos from "./SectionPhotos.astro";

interface Props {
  sections: { type: string; [cle: string]: unknown }[];
}

const composants: Record<string, (props: any) => any> = {
  intro: SectionIntro,
  missions: SectionMissions,
  pictos: SectionPictos,
  colonnes: SectionColonnes,
  pourquoi: SectionPourquoi,
  cta: SectionCta,
  realisations: SectionRealisations,
  chapo: SectionChapo,
  texte: SectionTexte,
  manifeste: SectionManifeste,
  appel: SectionAppel,
  valeurs: SectionValeurs,
  engagements: SectionEngagements,
  equipe: SectionEquipe,
  photos: SectionPhotos,
};

const { sections } = Astro.props;
---

{
  sections.map(({ type, ...props }) => {
    const Composant = composants[type];
    if (!Composant) throw new Error(`Type de section inconnu : « ${type} »`);
    return <Composant {...props} />;
  })
}
