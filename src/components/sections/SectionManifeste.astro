---
/** Raison d'être : phrase-manifeste, illustration pleine largeur, « les individus et les organisations » */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Texte from "../ui/Texte.astro";

interface Props {
  texte: string;
  image: { src: ImageMetadata; alt: string };
  duo: [string, string];
  liaison: string;
  conclusion: string;
}

const { texte, image, duo, liaison, conclusion } = Astro.props;
---

<section class="manifeste">
  <Texte class="manifeste__texte container" texte={texte} />
  <Image class="manifeste__image" src={image.src} alt={image.alt} widths={[800, 1440, 1920]} sizes="100vw" loading="eager" />
  <p class="manifeste__duo container">
    <Texte as="span" texte={duo[0]} />
    <span class="manifeste__liaison">{liaison}</span>
    <Texte as="span" texte={duo[1]} />
  </p>
  <Texte class="manifeste__conclusion container" texte={conclusion} />
</section>

<style>
  .manifeste {
    padding-bottom: var(--space-xl);
    text-align: center;
  }

  .manifeste :global(.manifeste__texte) {
    font-size: var(--text-md);
    line-height: 1.3;
  }

  .manifeste :global(.txt-script) {
    display: inline-block;
    font-size: clamp(3rem, 2rem + 3vw, 4.5rem);
    line-height: 1.1;
  }

  .manifeste__image {
    width: 100%;
    margin-top: var(--space-xs);
  }

  .manifeste__duo {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    align-items: start;
    gap: var(--space-sm);
    max-width: 56rem;
    padding-block: var(--space-lg);
    font-size: var(--text-xl);
    line-height: 1;
  }

  .manifeste__liaison {
    font-size: 0.7em;
  }

  .manifeste :global(.manifeste__conclusion) {
    max-width: 42rem;
    font-size: var(--text-md);
  }
</style>
