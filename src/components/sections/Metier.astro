---
import { Image } from "astro:assets";
import RichText, { type Segment } from "../ui/RichText.astro";
import { getImage } from "../../lib/images";

interface Props {
  titre: Segment[];
  paragraphes: string[];
  items: { image: string; alt: string }[];
  navigationCarrousel: string;
}

const { titre, paragraphes, items, navigationCarrousel } = Astro.props;
---

<section class="metier" aria-labelledby="metier-titre">
  <div class="metier__intro container">
    <h2 class="metier__titre" id="metier-titre"><RichText segments={titre} /></h2>
    {paragraphes.map((p) => <p>{p}</p>)}
  </div>

  <ul class="metier__liste" role="list">
    {
      items.map((item) => (
        <li class="metier__item">
          <Image src={getImage(item.image)} alt={item.alt} widths={[400, 515]} sizes="(min-width: 48rem) 25vw, 85vw" />
        </li>
      ))
    }
  </ul>

  <div class="metier__points" hidden>
    {
      items.map((_, i) => (
        <button
          type="button"
          class="metier__point"
          aria-label={navigationCarrousel.replace("{n}", String(i + 1)).replace("{total}", String(items.length))}
          aria-current={i === 0 ? "true" : undefined}
        />
      ))
    }
  </div>
</section>

<script>
  // Points de navigation du carrousel mobile (le défilement au doigt marche sans JS)
  document.querySelectorAll<HTMLElement>(".metier").forEach((section) => {
    const liste = section.querySelector<HTMLElement>(".metier__liste");
    const points = section.querySelector<HTMLElement>(".metier__points");
    if (!liste || !points) return;
    const items = Array.from(liste.children) as HTMLElement[];
    const boutons = Array.from(points.children) as HTMLButtonElement[];
    points.hidden = false;

    boutons.forEach((bouton, i) =>
      bouton.addEventListener("click", () => items[i].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" })),
    );

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = items.indexOf(entry.target as HTMLElement);
          boutons.forEach((b, i) => (i === index ? b.setAttribute("aria-current", "true") : b.removeAttribute("aria-current")));
        });
      },
      { root: liste, threshold: 0.6 },
    );
    items.forEach((item) => observer.observe(item));
  });
</script>

<style>
  .metier {
    padding-block: var(--space-2xl);
    background: var(--color-beige);
  }

  .metier__intro {
    display: grid;
    gap: var(--space-sm);
    text-align: center;
  }

  .metier__titre {
    margin-bottom: var(--space-xs);
    font-size: var(--text-lg);
    text-transform: uppercase;
  }

  .metier__liste {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding: 0 var(--gutter);
    list-style: none;
  }

  .metier__item {
    flex: 1 1 0;
    min-width: 0;
  }

  .metier__item img {
    width: 100%;
  }

  .metier__points {
    display: none;
  }

  /* Mobile : carrousel horizontal */
  @media (max-width: 47.99rem) {
    .metier__liste {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-inline: 7.5vw;
      scroll-padding-inline: 7.5vw;
    }

    .metier__liste::-webkit-scrollbar {
      display: none;
    }

    .metier__item {
      flex: 0 0 85vw;
      scroll-snap-align: center;
    }

    .metier__points:not([hidden]) {
      display: flex;
      justify-content: center;
      gap: var(--space-xs);
      margin-top: var(--space-md);
    }

    .metier__point {
      width: 0.75rem;
      height: 0.75rem;
      padding: 0;
      border: 1px solid var(--color-bleu-fonce);
      border-radius: 50%;
      background: transparent;
      cursor: pointer;
      transition: transform var(--transition), background-color var(--transition);
    }

    .metier__point[aria-current="true"] {
      background: var(--color-bleu-fonce);
      transform: scale(1.3);
    }
  }
</style>
