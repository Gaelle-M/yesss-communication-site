---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Texte from "../ui/Texte.astro";

interface Props {
  titre: string;
  paragraphes: string[];
  image: { src: ImageMetadata; alt: string };
}

const { titre, paragraphes, image } = Astro.props;
---

<section class="intro-section">
  <div class="intro-section__inner container">
    <div class="intro-section__texte">
      <Texte as="h2" class="intro-section__titre" texte={titre} />
      {paragraphes.map((p) => <Texte texte={p} />)}
    </div>
    <Image class="intro-section__image" src={image.src} alt={image.alt} widths={[400, 570]} sizes="(min-width: 48rem) 36rem, 90vw" loading="eager" />
  </div>
</section>

<style>
  .intro-section {
    padding-block: var(--space-lg) var(--space-xl);
  }

  .intro-section__inner {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    max-width: var(--container-narrow);
  }

  .intro-section__texte {
    display: grid;
    gap: var(--space-sm);
    font-size: var(--text-sm);
  }

  .intro-section__texte :global(.intro-section__titre) {
    margin-bottom: var(--space-xs);
    font-size: var(--text-md);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .intro-section__image {
    width: min(100%, 26rem);
    margin-inline: auto;
  }

  @media (min-width: 48rem) {
    .intro-section__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
