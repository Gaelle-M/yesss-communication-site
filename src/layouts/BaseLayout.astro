---
import "../styles/global.css";
import site from "../content/site.json";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Variante de l'en-tête : "plein" pour les pages sans grand visuel en haut */
  header?: "transparent" | "plein";
  /** Variables CSS d'un thème (pages projet), voir src/lib/theme.ts */
  theme?: string;
  /** Le fond du pied de page est clair */
  fondClair?: boolean;
}

const { title, description, header = "transparent", theme, fondClair = false } = Astro.props;
---

<!doctype html>
<html lang={site.langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/Lexend-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Lexend-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Typo script "adventures-unlimited" (Adobe Fonts) -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/cps6zjo.css" />
  </head>
  <body style={theme}>
    <ul class="skip-links" role="list">
      {
        site.accessibilite.liensEvitement.map((lien) => (
          <li>
            <a href={lien.href}>{lien.label}</a>
          </li>
        ))
      }
    </ul>
    <Header variante={header} />
    <main id="contenu" tabindex="-1" class:list={{ "main--sous-header": header === "plein" }}>
      <slot />
    </main>
    <Footer fondClair={fondClair} />
  </body>
</html>

<style>
  .skip-links {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skip-links a {
    position: absolute;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-jaune);
    color: var(--color-bleu-nuit);
    font-weight: var(--font-weight-bold);
    white-space: nowrap;
    transform: translateY(-120%);
  }

  .skip-links a:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  /* L'en-tête fixe à fond plein ne recouvre pas le haut de la page */
  .main--sous-header {
    padding-top: calc(var(--header-height) + 2px);
  }
</style>
